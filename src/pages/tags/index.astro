---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts, termSlug } from '../../lib/posts';

const posts = await getPublishedPosts();
const counts = posts.reduce((map, post) => {
  for (const tag of post.data.tags) map.set(tag, (map.get(tag) ?? 0) + 1);
  return map;
}, new Map<string, number>());
const tags = [...counts.entries()].sort((a, b) => a[0].localeCompare(b[0]));
---

<BaseLayout title="标签 | AlwaysBluer" description="按标签浏览 AlwaysBluer 的文章。">
  <section class="listing-page page-shell">
    <header class="page-intro">
      <p>交叉索引</p>
      <h1>标签</h1>
      <span>{tags.length} 个主题</span>
    </header>
    <ul class="term-grid">
      {tags.map(([tag, count]) => (
        <li><a href={`/tags/${encodeURIComponent(termSlug(tag))}/`}><span>{tag}</span><strong>{count}</strong></a></li>
      ))}
    </ul>
  </section>
</BaseLayout>
