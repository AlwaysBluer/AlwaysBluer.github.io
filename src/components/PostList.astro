---
import type { Post } from '../lib/posts';
import { formatDate, postUrl, termSlug } from '../lib/posts';

interface Props {
  posts: Post[];
}

const { posts } = Astro.props;
---

<ol class="post-list">
  {posts.map((post) => (
    <li class="post-list__item">
      <time datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt)}</time>
      <div class="post-list__body">
        <h2><a href={postUrl(post)}>{post.data.title}</a></h2>
        <p>{post.data.description}</p>
        <div class="post-list__terms" aria-label="文章标签">
          <a href={`/categories/${encodeURIComponent(post.data.category)}/`}>{post.data.category}</a>
          {post.data.tags.map((tag) => (
            <a href={`/tags/${encodeURIComponent(termSlug(tag))}/`}>#{tag}</a>
          ))}
        </div>
      </div>
    </li>
  ))}
</ol>
